{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "required": [
            "solutionUniqueName",
            "evaluationName",
            "sourceEnvironmentId",
            "agentIds",
            "correlationId",
            "artifactSha256",
            "sourceFingerprint"
          ],
          "additionalProperties": false,
          "properties": {
            "solutionUniqueName": {
              "type": "string",
              "minLength": 1
            },
            "evaluationName": {
              "type": "string",
              "minLength": 1
            },
            "sourceEnvironmentId": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "agentIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              }
            },
            "correlationId": {
              "type": "string",
              "minLength": 1
            },
            "artifactSha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "sourceFingerprint": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            }
          }
        },
        "triggerAuthenticationType": "User",
        "triggerAllowedUsers": "__CALLER_OBJECT_ID__"
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        },
        "secureData": {
          "properties": [
            "outputs"
          ]
        }
      }
    }
  },
  "actions": {
    "Initialize_result": {
      "runAfter": {
        "Validate_environment": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "EvaluationResult",
            "type": "object",
            "value": {
              "state": "Queued"
            }
          },
          {
            "name": "MatchingSets",
            "type": "array",
            "value": []
          },
          {
            "name": "PassingCases",
            "type": "array",
            "value": []
          }
        ]
      }
    },
    "Evaluate_and_wait": {
      "actions": {
        "Start_evaluation": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Agent": "@outputs('Candidate')?['agentId']",
              "TestSetId": "@outputs('Candidate')?['testSetId']",
              "body": {
                "mcsConnectionId": "__CONNECTION_NAME__"
              }
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio",
              "connectionName": "shared_microsoftcopilotstudio",
              "operationId": "RunAgentMakerEvaluationTestSet"
            },
            "retryPolicy": {
              "type": "none"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Validate_start": {
          "runAfter": {
            "Start_evaluation": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Start_evaluation')",
            "schema": {
              "type": "object",
              "required": [
                "runId",
                "totalTestCases"
              ],
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "totalTestCases": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Wait_for_evaluation": {
          "actions": {
            "Delay": {
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 15,
                  "unit": "Second"
                }
              }
            },
            "Get_evaluation": {
              "runAfter": {
                "Delay": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "Agent": "@outputs('Candidate')?['agentId']",
                  "EvaluationRunId": "@body('Validate_start')?['runId']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio",
                  "connectionName": "shared_microsoftcopilotstudio",
                  "operationId": "GetAgentMakerEvaluationTestRunDetails"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Store_result": {
              "runAfter": {
                "Get_evaluation": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "EvaluationResult",
                "value": "@body('Get_evaluation')"
              }
            }
          },
          "runAfter": {
            "Validate_start": [
              "Succeeded"
            ]
          },
          "expression": "@not(contains(createArray('Queued','InProgress'),variables('EvaluationResult')?['state']))",
          "limit": {
            "count": 80,
            "timeout": "PT20M"
          },
          "type": "Until",
          "operationOptions": "FailWhenLimitsReached"
        },
        "Validate_result": {
          "runAfter": {
            "Wait_for_evaluation": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@variables('EvaluationResult')",
            "schema": {
              "type": "object",
              "required": [
                "id",
                "environmentId",
                "cdsBotId",
                "testSetId",
                "state",
                "totalTestCases",
                "testCasesResults"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "environmentId": {
                  "type": "string"
                },
                "cdsBotId": {
                  "type": "string"
                },
                "testSetId": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "totalTestCases": {
                  "type": "integer"
                },
                "testCasesResults": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "testCaseId",
                      "state",
                      "metricsResults"
                    ],
                    "properties": {
                      "testCaseId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "state": {
                        "type": "string"
                      },
                      "metricsResults": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "type",
                            "result"
                          ],
                          "properties": {
                            "type": {
                              "type": "string"
                            },
                            "result": {
                              "type": "object",
                              "required": [
                                "status"
                              ],
                              "properties": {
                                "status": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Passing_cases": {
          "runAfter": {
            "For_each_case": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@variables('PassingCases')",
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Case_ids": {
          "runAfter": {
            "Passing_cases": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Validate_result')?['testCasesResults']",
            "select": {
              "id": "@item()?['testCaseId']"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Gate_passed": {
          "runAfter": {
            "Case_ids": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@and(equals(body('Validate_result')?['id'],body('Validate_start')?['runId']),equals(body('Validate_result')?['environmentId'],triggerBody()?['sourceEnvironmentId']),equals(body('Validate_result')?['cdsBotId'],outputs('Candidate')?['agentId']),equals(body('Validate_result')?['testSetId'],outputs('Candidate')?['testSetId']),equals(body('Validate_result')?['state'],'Completed'),equals(body('Validate_result')?['totalTestCases'],body('Validate_start')?['totalTestCases']),equals(length(body('Validate_result')?['testCasesResults']),body('Validate_start')?['totalTestCases']),equals(length(union(body('Case_ids'),body('Case_ids'))),body('Validate_start')?['totalTestCases']),equals(length(outputs('Passing_cases')),body('Validate_start')?['totalTestCases']))",
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "For_each_case": {
          "foreach": "@body('Validate_result')?['testCasesResults']",
          "actions": {
            "Nonpassing_metrics": {
              "runAfter": {},
              "type": "Query",
              "inputs": {
                "from": "@items('For_each_case')?['metricsResults']",
                "where": "@not(equals(item()?['result']?['status'],'Pass'))"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              }
            },
            "Case_passes": {
              "actions": {
                "Collect_passing_case": {
                  "runAfter": {},
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "PassingCases",
                    "value": "@items('For_each_case')"
                  }
                }
              },
              "runAfter": {
                "Nonpassing_metrics": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {}
              },
              "expression": "@and(equals(items('For_each_case')?['state'],'Completed'),greater(length(items('For_each_case')?['metricsResults']),0),equals(length(body('Nonpassing_metrics')),0))",
              "type": "If"
            }
          },
          "runAfter": {
            "Validate_result": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "operationOptions": "Sequential"
        }
      },
      "runAfter": {
        "Candidate": [
          "Succeeded"
        ]
      },
      "type": "Scope"
    },
    "Evaluation_response": {
      "runAfter": {
        "Evaluate_and_wait": [
          "Succeeded"
        ]
      },
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schemaVersion": 2,
          "solutionUniqueName": "@triggerBody()?['solutionUniqueName']",
          "evaluationName": "@outputs('Candidate')?['evaluationName']",
          "correlationId": "@triggerBody()?['correlationId']",
          "artifactSha256": "@triggerBody()?['artifactSha256']",
          "sourceFingerprint": "@triggerBody()?['sourceFingerprint']",
          "flowRunId": "@workflow()?['run']?['name']",
          "evaluationRunId": "@body('Validate_start')?['runId']",
          "environmentId": "@body('Validate_result')?['environmentId']",
          "agentId": "@body('Validate_result')?['cdsBotId']",
          "testSetId": "@body('Validate_result')?['testSetId']",
          "state": "@body('Validate_result')?['state']",
          "expectedTests": "@body('Validate_start')?['totalTestCases']",
          "totalTests": "@body('Validate_result')?['totalTestCases']",
          "passedTests": "@length(outputs('Passing_cases'))",
          "passed": "@outputs('Gate_passed')",
          "testCasesResults": "@body('Validate_result')?['testCasesResults']"
        }
      },
      "operationOptions": "Asynchronous",
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      }
    },
    "Error_response": {
      "runAfter": {
        "Evaluate_and_wait": [
          "Failed",
          "TimedOut",
          "Skipped"
        ]
      },
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 500,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schemaVersion": 2,
          "solutionUniqueName": "@triggerBody()?['solutionUniqueName']",
          "evaluationName": "@triggerBody()?['evaluationName']",
          "correlationId": "@triggerBody()?['correlationId']",
          "flowRunId": "@workflow()?['run']?['name']",
          "passed": false,
          "state": "Error",
          "reason": "Evaluation discovery or execution did not produce complete valid evidence. Deployment is blocked.",
          "error": {
            "code": "EvaluationDiscoveryOrExecutionFailed"
          }
        }
      },
      "operationOptions": "Asynchronous",
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      }
    },
    "Candidate": {
      "runAfter": {
        "Resolve_evaluation": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@first(body('Validate_match'))",
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      }
    },
    "Resolve_evaluation": {
      "actions": {
        "For_each_agent": {
          "foreach": "@triggerBody()?['agentIds']",
          "actions": {
            "List_test_sets": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio",
                  "connectionName": "shared_microsoftcopilotstudio",
                  "operationId": "GetAgentMakerEvaluationTestSets"
                },
                "parameters": {
                  "Agent": "@items('For_each_agent')"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Filter_named_sets": {
              "runAfter": {
                "List_test_sets": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@if(and(empty(body('List_test_sets')?['@odata.nextLink']),empty(body('List_test_sets')?['nextLink'])),body('List_test_sets')?['value'],null)",
                "where": "@and(equals(item()?['displayName'],triggerBody()?['evaluationName']),equals(item()?['state'],'Active'))"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              }
            },
            "For_each_match": {
              "foreach": "@body('Filter_named_sets')",
              "actions": {
                "Collect_match": {
                  "runAfter": {},
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "MatchingSets",
                    "value": {
                      "agentId": "@items('For_each_agent')",
                      "testSetId": "@item()?['id']",
                      "evaluationName": "@item()?['displayName']"
                    }
                  }
                }
              },
              "runAfter": {
                "Filter_named_sets": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "operationOptions": "Sequential"
            }
          },
          "runAfter": {},
          "type": "Foreach",
          "operationOptions": "Sequential"
        },
        "Validate_match": {
          "runAfter": {
            "For_each_agent": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@variables('MatchingSets')",
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "agentId",
                  "testSetId",
                  "evaluationName"
                ],
                "properties": {
                  "agentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "testSetId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evaluationName": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        }
      },
      "runAfter": {
        "Initialize_result": [
          "Succeeded"
        ]
      },
      "type": "Scope"
    },
    "Validate_environment": {
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      },
      "runAfter": {},
      "inputs": {
        "content": {
          "sourceEnvironmentId": "@triggerBody()?['sourceEnvironmentId']"
        },
        "schema": {
          "properties": {
            "sourceEnvironmentId": {
              "enum": [
                "__SOURCE_ENVIRONMENT_ID__"
              ],
              "type": "string"
            }
          },
          "required": [
            "sourceEnvironmentId"
          ],
          "type": "object"
        }
      },
      "type": "ParseJson"
    }
  },
  "outputs": {}
}
